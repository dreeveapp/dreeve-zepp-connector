ZEPP_EMAIL=you@example.com
ZEPP_PASSWORD=your-zepp-password

# Where .FIT files are written - point this at Dreeve's watch folder. Keep
# this separate from STATE_DIR below: nothing but .FIT files should land
# here.
WATCH_DIR=./output

# Where the ledger (already-exported trackids + the cached login token)
# lives. Deliberately a different directory from WATCH_DIR so it never ends
# up in Dreeve's watch folder. Default "./state"; LEDGER_PATH overrides the
# ledger's exact file path if you need it somewhere else entirely.
# STATE_DIR=./state
# LEDGER_PATH=./state/ledger.json

# Optional: only export workouts starting from this point. Same syntax as
# the --since CLI flag: an ISO date ("2026-07-24"), a "-Nd" relative offset
# ("-30d"), or "all". If unset, every workout up to --limit is considered
# (already-exported ones are still skipped via the ledger either way).
# SINCE=-30d

# Optional: country code passed to Zepp's web-app login flow (default "US").
# Try your account's actual country if login fails.
# ZEPP_COUNTRY=US

# Optional: device names written into each .FIT file's DeviceInfoMessage,
# mapped per physical device. Zepp's API doesn't expose the recording
# device's model anywhere in workout data, so this can't be auto-detected
# from your account - common devices already resolve out of the box via a
# built-in table (known_devices.py, sourced from Zepp's own device-list
# docs), so you only need this if your device isn't in that table, or to
# override the name it picks. Format: <device_id>=<name>, semicolon-
# separated for multiple devices (e.g. if you've owned more than one watch
# on this account). To find your device_id(s), run:
#   uv run dreeve-zepp-connector --dry-run
# which prints "(dry-run) would export ... (device_id=9568513)" per
# workout - no export happens, it's just listing what's there.
# ZEPP_DEVICE_NAMES=9568513=Amazfit Balance 2;1234567=Amazfit GTR 4

# Optional: max workouts to fetch in total per run/cycle, same as --limit
# (default 200; a CLI --limit flag overrides this for the one-shot command).
# LIMIT=200

# Optional: retry/backoff for Zepp API calls. ZEPP_MAX_RETRIES caps retry
# attempts on connection errors and HTTP 429s (default 5); ZEPP_RETRY_BASE_DELAY
# is the base seconds for exponential backoff between attempts (default 2.0;
# a 429's Retry-After header, if present, is honored instead).
# ZEPP_MAX_RETRIES=5
# ZEPP_RETRY_BASE_DELAY=2.0

# Optional: pace per-workout detail downloads. DOWNLOAD_DELAY_SECONDS sleeps
# this long after each workout's detail is fetched (default 0 - no delay).
# MAX_DOWNLOADS_PER_CYCLE caps how many new workouts are exported in a single
# run/cycle (default unset - unlimited); anything past the cap is picked up
# automatically by the next run/cycle via the ledger, no extra bookkeeping
# needed. Useful for a large first-time backfill run continuously via the
# loop below, so it doesn't hammer the API in one go.
# DOWNLOAD_DELAY_SECONDS=0.5
# MAX_DOWNLOADS_PER_CYCLE=50

# Optional: only used by the continuous polling daemon
# (`dreeve-zepp-connector-loop` / `python -m dreeve_zepp_connector.loop`,
# also the default Docker command) - not the one-shot CLI. POLL_INTERVAL is
# the seconds between sync cycles (default 3600). HEALTH_PORT serves
# /healthz (liveness) and /status (JSON cycle history) for monitoring when
# run as a long-lived container (default 8080). Under Docker, HEALTH_PORT
# also drives docker-compose.yml's host port mapping (same variable, read
# from this file) - change it here if 8080 is already taken on your host,
# no compose file edits needed.
# CYCLE_TIMEOUT is a hard cap in seconds on one sync cycle (default 1800; 0
# disables it) - a cycle still running after that is killed, logged as a
# failed cycle, and retried on the next poll.
# POLL_INTERVAL=3600
# HEALTH_PORT=8080
# CYCLE_TIMEOUT=1800
